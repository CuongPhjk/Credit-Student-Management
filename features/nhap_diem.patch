+            const string ma = danhSach[i].MASV;
+            delete[] danhSach;
+            throw py::value_error("Không tìm thấy thông tin sinh viên " + ma);
+        }
+        dong["ho"] = sv.HO;
+        dong["ten"] = sv.TEN;
+        dong["diem"] = danhSach[i].DIEM;
+        dong["da_co_diem"] = (danhSach[i].DIEM >= 0);
+        ketQua.append(dong);
+    }
+    delete[] danhSach;
+    return ketQua;
+}
+
+bool capNhatDanhSachDiem(
+    DiemManager& manager,
+    const std::string& nienKhoa,
+    int hocKy,
+    const std::string& maMH,
+    int nhom,
+    const py::list& danhSachDiem,
+    bool ghiFile = true
+) {
+    const int soLuong = static_cast<int>(py::len(danhSachDiem));
+    if (soLuong <= 0) {
+        throw py::value_error("Danh sách điểm cập nhật không được để trống.");
+    }
+    std::unique_ptr<DangKy[]> danhSachMoi(
+        new DangKy[soLuong]
+    );
+    for (int i = 0; i < soLuong; ++i) {
+        py::handle muc = danhSachDiem[i];
+        if (!py::isinstance<py::dict>(muc)) {
+            throw py::value_error(
+                "Mỗi dòng cập nhật điểm phải gồm ma_sv và diem."
+            );
+        }
+        py::dict dong = py::reinterpret_borrow<py::dict>(muc);
+        if (!dong.contains("ma_sv") || !dong.contains("diem")) {
+            throw py::value_error(
+                "Mỗi dòng cập nhật điểm phải gồm ma_sv và diem."
+            );
+        }
+        try {
+            danhSachMoi[i].MASV = py::cast<std::string>(dong["ma_sv"]);
+            danhSachMoi[i].DIEM = py::cast<float>(dong["diem"]);
+        } catch (const py::cast_error&) {
+            throw py::value_error(
+                "Mã sinh viên phải là chuỗi và điểm phải là số."
+            );
+        }
+    }
+
+    std::string loi;
+    if (!manager.capNhatDanhSachDiem(
+        nienKhoa, hocKy, maMH, nhom,
+        danhSachMoi.get(), soLuong, loi, ghiFile
+    )) {
         throw py::value_error(loi);
     }
     return true;
