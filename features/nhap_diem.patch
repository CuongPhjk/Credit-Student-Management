+"""Trang lọc sinh viên đã đăng ký và nhập điểm trực tiếp trên bảng."""
+
+import math
+
+from PyQt6.QtCore import QLocale, Qt, QTimer
+from PyQt6.QtGui import QDoubleValidator
+from PyQt6.QtWidgets import (
+    QAbstractItemView,
+    QComboBox,
+    QFrame,
+    QHBoxLayout,
