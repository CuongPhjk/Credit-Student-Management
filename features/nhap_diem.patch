new file mode 100644
--- /dev/null
+++ b/backend/src/functions/HamDiem.cpp
@@ -0,0 +1,45 @@
+#include "../KhaiBao.h"
+
+Loptinchi* TimLopNhapDiem(
+    DS_LTC& dsLTC, const string& nienKhoa, int hocKy,
+    const string& maMH, int nhom, string& loi
+) {
+    loi.clear();
+    Loptinchi* lop = TimLopTinChi(dsLTC, nienKhoa, hocKy, maMH, nhom);
+    if (lop == nullptr) {
+        loi = "Không tìm thấy lớp tín chỉ phù hợp.";
+        return nullptr;
+    }
+    if (lop->HUYLOP) {
+        loi = "Không thể nhập điểm cho lớp tín chỉ đã bị hủy.";
+        return nullptr;
+    }
+    return lop;
+}
+
+bool NhapDiem(Loptinchi& lop, const string& maSV, float diem, string& loi) {
+    loi.clear();
+    if (lop.HUYLOP) {
+        loi = "Không thể nhập điểm cho lớp tín chỉ đã bị hủy.";
+        return false;
+    }
+    PTRDK dangKy = TimDangKy(lop.dssvdk, maSV);
+    if (dangKy == nullptr || dangKy->dk.HUYDK) {
+        loi = "Sinh viên không có đăng ký còn hiệu lực trong lớp tín chỉ.";
+        return false;
+    }
+    dangKy->dk.DIEM = diem;
+    return true;
+}
+
+DangKy* LayDanhSachSinhVienNhapDiem(const Loptinchi& lop, int& soLuong) {
+    soLuong = 0;
+    for (PTRDK node = lop.dssvdk; node != nullptr; node = node->next)
+        if (!node->dk.HUYDK) ++soLuong;
+    if (soLuong == 0) return nullptr;
+    DangKy* ketQua = new DangKy[soLuong];
+    int i = 0;
+    for (PTRDK node = lop.dssvdk; node != nullptr; node = node->next)
+        if (!node->dk.HUYDK) ketQua[i++] = node->dk;
+    return ketQua;
+}
diff --git a/backend/src/manager/DiemManager.cpp b/backend/src/manager/DiemManager.cpp
new file mode 100644
--- /dev/null
+++ b/backend/src/manager/DiemManager.cpp
@@ -0,0 +1,90 @@
+#include "../KhaiBao.h"
+
+DiemManager::DiemManager(AppData& appData)
+    : appData_(appData) {}
+
+bool DiemManager::luu(std::string& loi) const {
+    return appData_.tenFileLopTinChi().empty()
+        || GhiDanhSachLopTinChi(
+            appData_.tenFileLopTinChi(), appData_.dsLopTinChi(), loi
+        );
+}
+
+DangKy* DiemManager::layDanhSachSinhVien(
+    const string& nienKhoa, int hocKy, const string& maMH, int nhom,
+    int& soLuong, string& loi
+) const {
+    const Loptinchi* lop = TimLopNhapDiem(
+        appData_.dsLopTinChi(), nienKhoa, hocKy, maMH, nhom, loi
+    );
+    if (lop == nullptr) { soLuong = -1; return nullptr; }
+    return LayDanhSachSinhVienNhapDiem(*lop, soLuong);
+}
+
+bool DiemManager::capNhatDanhSachDiem(
+    const std::string& nienKhoa,
+    int hocKy,
+    const std::string& maMH,
+    int nhom,
+    const DangKy dsDiemMoi[],
+    int soLuong,
+    std::string& loi,
+    bool ghiFile
+) {
+    loi.clear();
+    if (dsDiemMoi == nullptr || soLuong <= 0) {
+        loi = "Danh sách điểm cập nhật không được để trống.";
+        return false;
+    }
+
+    Loptinchi* lop = TimLopNhapDiem(
+        appData_.dsLopTinChi(), nienKhoa, hocKy, maMH, nhom, loi
+    );
+    if (lop == nullptr) return false;
+
+    // Check registration eligibility and duplicate rows before changing scores.
+    for (int i = 0; i < soLuong; ++i) {
+        const string ma = ChuanHoaMa(dsDiemMoi[i].MASV);
+        for (int j = 0; j < i; ++j) {
+            if (ChuanHoaMa(dsDiemMoi[j].MASV) == ma) {
+                loi = "Mã sinh viên bị lặp trong danh sách cập nhật.";
+                return false;
+            }
+        }
+        PTRDK dk = TimDangKy(lop->dssvdk, ma);
+        int viTriLop;
+        if (dk == nullptr || dk->dk.HUYDK
+            || TimSinhVienToanTruong(appData_.dsLop(), ma, viTriLop) == nullptr) {
+            loi = "Sinh viên không có đăng ký còn hiệu lực trong lớp tín chỉ.";
+            return false;
+        }
+    }
+    float* diemCu = new float[soLuong];
+    for (int i = 0; i < soLuong; ++i) {
+        PTRDK dk = TimDangKy(lop->dssvdk, dsDiemMoi[i].MASV);
+        diemCu[i] = dk->dk.DIEM;
+        if (!NhapDiem(*lop, dsDiemMoi[i].MASV, dsDiemMoi[i].DIEM, loi)) {
+            for (int j = 0; j < i; ++j)
+                TimDangKy(lop->dssvdk, dsDiemMoi[j].MASV)->dk.DIEM = diemCu[j];
+            delete[] diemCu;
+            return false;
+        }
+    }
+    const bool thanhCong = !ghiFile || luu(loi);
+    if (!thanhCong) {
+        for (int i = 0; i < soLuong; ++i)
+            TimDangKy(lop->dssvdk, dsDiemMoi[i].MASV)->dk.DIEM = diemCu[i];
+    }
+    delete[] diemCu;
+    return thanhCong;
+}
+
+bool DiemManager::luuDiem(string& loi) const { return luu(loi); }
+
+bool DiemManager::timSinhVien(const string& maSV, Sinhvien& ketQua) const {
+    int viTriLop;
+    PTRSV node = TimSinhVienToanTruong(appData_.dsLop(), maSV, viTriLop);
+    if (node == nullptr) return false;
+    ketQua = node->sv;
+    return true;
+}
