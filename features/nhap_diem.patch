+    const std::string& nienKhoa,
+    int hocKy,
+    const std::string& maMH,
+    int nhom
+) {
+    std::string loi;
+    int soLuong;
+    DangKy* danhSach = manager.layDanhSachSinhVien(
+        nienKhoa, hocKy, maMH, nhom, soLuong, loi
+    );
+    if (soLuong < 0) throw py::value_error(loi);
+    py::list ketQua;
+    for (int i = 0; i < soLuong; ++i) {
+        py::dict dong;
+        dong["ma_sv"] = danhSach[i].MASV;
+        Sinhvien sv;
